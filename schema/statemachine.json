{
  "$defs": {
    "Condition": {
      "properties": {
        "id": {
          "description": "The ID of the condition",
          "minimum": 0,
          "title": "ID",
          "type": "integer"
        },
        "channel": {
          "description": "The channel or global timer attached to the condition",
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "value": {
          "description": "The value of the condition channel if the condition is met",
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "channel",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "GlobalCounter": {
      "properties": {
        "id": {
          "description": "The ID of the global counter",
          "minimum": 0,
          "title": "ID",
          "type": "integer"
        },
        "event": {
          "description": "A state machine event",
          "minLength": 1,
          "title": "Event",
          "type": "string"
        },
        "threshold": {
          "description": "The count threshold to generate an event",
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Threshold",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "event",
        "threshold"
      ],
      "title": "GlobalCounter",
      "type": "object"
    },
    "GlobalTimer": {
      "properties": {
        "timer_id": {
          "description": "The ID of the global timer",
          "minimum": 0,
          "title": "Global Timer ID",
          "type": "integer"
        },
        "duration": {
          "description": "The duration of the global timer in seconds",
          "minimum": 0.0,
          "title": "Global Timer Duration",
          "type": "number"
        },
        "onset_delay": {
          "default": 0.0,
          "description": "The onset delay of the global timer in seconds",
          "minimum": 0.0,
          "title": "Onset Delay",
          "type": "number"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "value_on": {
          "default": 0,
          "description": "The value a channel is set to",
          "maximum": 255,
          "minimum": 0,
          "title": "Channel Value",
          "type": "integer"
        },
        "value_off": {
          "default": 0,
          "description": "The value a channel is set to",
          "maximum": 255,
          "minimum": 0,
          "title": "Channel Value",
          "type": "integer"
        },
        "send_events": {
          "default": true,
          "description": "Whether the global timer is sending events",
          "title": "Send Events",
          "type": "boolean"
        },
        "loop": {
          "default": 0,
          "description": "Whether the global timer is looping or not",
          "maximum": 255,
          "minimum": 0,
          "title": "Loop Mode",
          "type": "integer"
        },
        "loop_interval": {
          "default": 0.0,
          "description": "The interval in seconds that the global timer is looping",
          "minimum": 0.0,
          "title": "Loop Interval",
          "type": "number"
        },
        "onset_trigger": {
          "default": 0,
          "description": "An integer whose bits indicate other global timers to trigger",
          "minimum": 0,
          "title": "Onset Trigger",
          "type": "integer"
        }
      },
      "required": [
        "timer_id",
        "duration"
      ],
      "title": "GlobalTimer",
      "type": "object"
    },
    "State": {
      "description": "Represents a state in the state machine.",
      "properties": {
        "timer": {
          "default": 0.0,
          "description": "The state's timer in seconds",
          "minimum": 0.0,
          "title": "State Timer",
          "type": "number"
        },
        "state_change_conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "description": "The name of the state",
                "minLength": 1,
                "pattern": "^(?!>)(?!exit$).+$",
                "title": "State Name",
                "type": "string"
              },
              {
                "description": "A state machine operator",
                "pattern": "^(exit)|(>.+)$",
                "title": "Operator",
                "type": "string"
              }
            ]
          },
          "description": "A collection of events and their assigned target states",
          "propertyNames": {
            "description": "A state machine event",
            "minLength": 1
          },
          "title": "State Change Conditions",
          "type": "object"
        },
        "output_actions": {
          "additionalProperties": {
            "description": "The integer value of the output action",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "description": "A collection of output actions and their respective values",
          "propertyNames": {
            "description": "The name of the output action",
            "minLength": 1
          },
          "title": "Output Actions",
          "type": "object"
        },
        "comment": {
          "anyOf": [
            {
              "description": "A comment describing the state.",
              "title": "Comment",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        }
      },
      "title": "State",
      "type": "object"
    }
  },
  "description": "Represents a state machine with a collection of states.",
  "properties": {
    "name": {
      "default": "State Machine",
      "description": "The name of the state machine",
      "minLength": 1,
      "title": "State Machine Name",
      "type": "string"
    },
    "states": {
      "default": {},
      "patternProperties": {
        "^(?!>)(?!exit$).+$": {
          "$ref": "#/$defs/State"
        }
      },
      "propertyNames": {
        "description": "The name of the state",
        "minLength": 1
      },
      "title": "States",
      "type": "object"
    },
    "global_timers": {
      "additionalProperties": {
        "$ref": "#/$defs/GlobalTimer"
      },
      "default": {},
      "title": "Global Timers",
      "type": "object"
    },
    "global_counters": {
      "additionalProperties": {
        "$ref": "#/$defs/GlobalCounter"
      },
      "default": {},
      "title": "Global Counters",
      "type": "object"
    },
    "conditions": {
      "additionalProperties": {
        "$ref": "#/$defs/Condition"
      },
      "default": {},
      "title": "Conditions",
      "type": "object"
    }
  },
  "title": "StateMachine",
  "type": "object"
}
